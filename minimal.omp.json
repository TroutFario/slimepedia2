{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "shell",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#0077c2",
          "template": "\uf120 {{ .Name }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#2d3436",
          "background": "#FF9248",
          "template": "\uf07b {{ .Path }} "
        }
      ]
    }
  ],
  "version": 3
}
